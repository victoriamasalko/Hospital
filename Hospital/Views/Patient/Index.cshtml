@model IEnumerable<Hospital.Models.Patient>
@{
    ViewData["Title"] = "Patients";
}
<h2>Overview Of Patients</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Date of Birth</th>
            <th>Diagnosis</th>
            <th>Room</th>
            <th>Registration Date</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var patient in Model)
        {
            <tr>
                <td>@patient.Id</td>
                <td>@patient.FirstName</td>
                <td>@patient.LastName</td>
                <td>@patient.Birthdate.ToString("dd/MM/yyyy")</td>
                <td>@patient.Diagnosis</td>
                <td>@patient.RoomNumber</td>
                <td>@patient.RegistrationDate.ToString("dd/MM/yyyy")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@patient.Id" class="btn btn-sm btn-dark">Details</a>
                    <a asp-controller="Medication" asp-action="Index" asp-route-patientId="@patient.Id" class="btn btn-sm btn-dark">MED</a>
                    <a asp-controller="PsychReport" asp-action="Index" asp-route-patientId="@patient.Id" class="btn btn-sm btn-dark">PSY</a>
                    @if (User.IsInRole("Nurse"))
                    {
                        <a asp-action="Edit" asp-route-id="@patient.Id">  <img class="overviewIcon" src="~/images/edit.png" alt="edit"></a>
                        <a asp-action="Discharge" asp-route-id="@patient.Id"> <img class="overviewIcon" src="~/images/delete.png" alt="delete"></a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
@if (User.IsInRole("Nurse"))
{
    <a asp-action="Add" class="btn btn-outline-secondary mt-3">Add Patient</a>
}

<a asp-action="AdmissionHistory" class="btn btn-outline-secondary mt-3">View Admission History</a>
