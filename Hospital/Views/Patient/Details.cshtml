@model Hospital.Models.Patient
@{
    ViewData["Title"] = "Patient Details";
}

<h2>Patient Details</h2>

<div class="row">
    <!-- Left Column: Patient Details (takes 8 out of 12 grid columns) -->
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-5">ID</dt>
            <dd class="col-sm-7">@Model.Id</dd>

            <dt class="col-sm-5">First Name</dt>
            <dd class="col-sm-7">@Model.FirstName</dd>

            <dt class="col-sm-5">Last Name</dt>
            <dd class="col-sm-7">@Model.LastName</dd>

            <dt class="col-sm-5">Diagnosis</dt>
            <dd class="col-sm-7">@Model.Diagnosis</dd>

            <dt class="col-sm-5">Date of Birth</dt>
            <dd class="col-sm-7">@Model.Birthdate.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-5">Gender</dt>
            <dd class="col-sm-7">@Model.Gender</dd>

            <dt class="col-sm-5">Address</dt>
            <dd class="col-sm-7">@Model.Address</dd>

            <dt class="col-sm-5">Phone Number</dt>
            <dd class="col-sm-7">@Model.PhoneNumber</dd>

            <dt class="col-sm-5">Registration Date</dt>
            <dd class="col-sm-7">@Model.RegistrationDate.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-5">Room Number</dt>
            <dd class="col-sm-7">@Model.RoomNumber</dd>

            <dt class="col-sm-5">Room Type</dt>
            <dd class="col-sm-7">@Model.RoomType</dd>

            <dt class="col-sm-5">Allergies</dt>
            <dd class="col-sm-7">@(Model.Allergies ?? "None")</dd>
        </dl>
    </div>

    <!-- Right Column: Profile Picture (takes 4 out of 12 grid columns) -->
    <div class="col-md-5 d-flex justify-content-center align-items-start">
        <img src="~/images/person.png" alt="picture" class="img-fluid" style="width: 300px; height: auto;" />
    </div>
</div>

<div class="mt-4">
    <a asp-action="Index" class="btn btn-outline-secondary">Back to overview</a>
</div>

